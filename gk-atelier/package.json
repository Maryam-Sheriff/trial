{
  "name": "gk-atelier-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website for GK Atelier by Ghada Khalil — handmade creations, ordered through WhatsApp.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "build:release": "node src/build.mjs --release",
    "check": "node src/check.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node src/build.mjs && node scripts/serve.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/amiri": "5.2.6",
    "@fontsource/cormorant-garamond": "5.2.8",
    "@fontsource/ibm-plex-sans-arabic": "5.2.6",
    "@fontsource/jost": "5.2.6",
    "js-yaml": "4.3.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
